# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored; never commit real credentials.
#
# Both values are safe to expose in the bundle that ships to browsers:
# Supabase row-level security controls real access. The anon key is
# intentionally the public/anon key from Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
